#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: script-run [--headless] <model>

Runs a model through the models Makefile from anywhere. The workspace is read
from $GRC_WS, which the generated env file exports; source it once first:

  ws/src/grc_meta/script-setup <workspace> <ros-distro>
  source <workspace>/setup-grc.bash    # or .zsh
  script-run pick_place_single
  script-run --headless admittance_arc_single

Arguments:
  model        Model to run (required).

Options:
  --headless   Run without a GUI (make run-headless); needs no display.
               Honors STEPS=<n> from the environment.

Environment:
  GRC_WS=<path>    Workspace root (exported by the sourced setup-grc env file).
  DIR=<path>       Generated artifact root passed to the models Makefile.
  RUN_ID=<id>      Run identifier for the cataloged archive.
  RUN_DIR=<path>   Run archive directory.
USAGE
}

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

check_upstream() {
    local repo_dir
    repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
    git -C "$repo_dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 || return 0
    git -C "$repo_dir" fetch --quiet origin 2>/dev/null || return 0
    git -C "$repo_dir" merge-base --is-ancestor HEAD '@{u}' 2>/dev/null || return 0
    git -C "$repo_dir" diff --quiet HEAD '@{u}' 2>/dev/null && return 0
    printf '\033[1;33m==> grc_meta has upstream changes. Syncing...\033[0m\n' >&2
    git -C "$repo_dir" pull --ff-only --quiet 2>/dev/null || {
        printf '\033[1;31mFailed to fast-forward. Update manually:\033[0m\n' >&2
        printf '  \033[0;36mgit -C %s pull --ff-only\033[0m\n' "$repo_dir" >&2
        exit 1
    }
    printf '\033[1;32mgrc_meta updated. Rerun:\033[0m\n' >&2
    printf '  \033[0;36m%s %s\033[0m\n' "$(basename "$0")" "$*" >&2
    exit 0
}

HEADLESS=0
args=()
for a in "$@"; do
    case "$a" in
        --headless) HEADLESS=1 ;;
        -h|--help) usage; exit 0 ;;
        *) args+=("$a") ;;
    esac
done
set -- "${args[@]}"
check_upstream "$@"

[ "$#" -eq 1 ] || { usage; exit 2; }

# The workspace comes from $GRC_WS, exported by the sourced setup-grc env file.
# If it's missing, the env was never built or never sourced: point the user there.
[ -n "${GRC_WS:-}" ] || die "GRC_WS is not set. Build the workspace and source its env first:
  ws/src/grc_meta/script-setup <workspace> <ros-distro>
  source <workspace>/setup-grc.bash    # or .zsh
then run script-run again (from any directory)."
WS="$GRC_WS"
[ -d "$WS" ] || die "GRC_WS points to a missing directory: $WS"
WS="$(cd -- "$WS" && pwd -P)"

RUN_SHELL="${SHELL:-/bin/bash}"
ENV_FILE="$WS/setup-grc.${RUN_SHELL##*/}"
MODELS_DIR="$WS/src/bdd_collab_bhv_cpp/models"

[ -x "$RUN_SHELL" ] || die "run shell is not executable: $RUN_SHELL"
[ -r "$ENV_FILE" ] || die "missing $ENV_FILE; run script-setup first"
[ -d "$MODELS_DIR" ] || die "missing models directory: $MODELS_DIR"

MODEL="$1"

target="run"
if [ "$HEADLESS" -eq 1 ]; then
    target="run-headless"
elif [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
    die "no GUI display detected; set DISPLAY/WAYLAND_DISPLAY, or pass --headless"
fi

exec "$RUN_SHELL" -lc '
set -e
source "$1"
cd "$2"
exec make "$3" MODEL="$4"
' _ "$ENV_FILE" "$MODELS_DIR" "$target" "$MODEL"
