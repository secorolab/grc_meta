#!/usr/bin/env bash
set -euo pipefail

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

exec 5>&1  # save a copy of stdout for run() traces

usage() {
    cat <<'USAGE'
Usage: script-setup [--clean] [--ff|--build] <workspace-path> <ros-distro>

Creates and builds a ROS 2 workspace.

Modes (default: full setup & build):
  --ff      Update repos and submodules, build only what moved, rewrite the
            environment file.
  --build   Rebuild only (assumes --ff or full setup was already run).

Options:
  --clean   Remove build/ install/ log/ before building.

Environment variables:
  GRC_GIT_TRANSPORT=ssh|https   Repository URL mode for grc_meta.repos.
  VERBOSE=1                     Print command traces for debugging.
  GRC_SETUP_QUIET=1             Suppress the final line in the generated env file.
USAGE
}

die() {
    printf "${BOLD}${RED}Error: %s${NC}\n" "$*" >&2
    exit 1
}

log() {
    printf "\n${BOLD}${CYAN}==> %s${NC}\n" "$*"
}

run() {
    printf "${YELLOW}+" >&5
    printf ' %q' "$@" >&5
    printf "${NC}\n" >&5
    "$@"
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command '$1' is missing${2:+ -- $2}"
}

quote_path() {
    printf '%q' "$1"
}

# Source a setup/activate file with nounset off; ROS 2/colcon files reference
# unbound vars. Do not enable xtrace here: those files export huge paths.
source_env() {
    [ -r "$1" ] || die "cannot source missing file: $1"
    set +u
    # shellcheck disable=SC1090
    source "$1"
    set -u
}

check_upstream() {
    local repo_dir
    repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
    git -C "$repo_dir" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 || return 0
    git -C "$repo_dir" fetch --quiet origin 2>/dev/null || return 0
    git -C "$repo_dir" merge-base --is-ancestor HEAD '@{u}' 2>/dev/null || return 0
    git -C "$repo_dir" diff --quiet HEAD '@{u}' 2>/dev/null && return 0
    printf '\033[1;33m==> grc_meta has upstream changes. Syncing...\033[0m\n' >&2
    git -C "$repo_dir" pull --ff-only --quiet 2>/dev/null || {
        printf '\033[1;31mFailed to fast-forward. Update manually:\033[0m\n' >&2
        printf '  \033[0;36mgit -C %s pull --ff-only\033[0m\n' "$repo_dir" >&2
        exit 1
    }
    printf '\033[1;32mgrc_meta updated. Rerun:\033[0m\n' >&2
    printf '  \033[0;36m%s %s\033[0m\n' "$(basename "$0")" "$*" >&2
    exit 0
}

CLEAN=0
MODE=full
args=()
for a in "$@"; do
    case "$a" in
        --clean) CLEAN=1 ;;
        --ff)    MODE=ff ;;
        --build) MODE=build ;;
        -h|--help) usage; exit 0 ;;
        *) args+=("$a") ;;
    esac
done
set -- "${args[@]}"
check_upstream "$@"

if [ "$#" -ne 2 ]; then
    usage
    exit 2
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=grc-lib.sh
source "$SCRIPT_DIR/grc-lib.sh"
REPOS_FILE="$SCRIPT_DIR/grc_meta.repos"
# GRC_COLCON_META overrides the colcon meta (e.g. CI builds without the Kinova
# Kortex hardware backend, which needs a proprietary artifactory download).
COLCON_META="${GRC_COLCON_META:-$SCRIPT_DIR/colcon.meta}"
COLCON_DEFAULTS="$SCRIPT_DIR/colcon_defaults.yaml"

[ -f "$REPOS_FILE" ] || die "missing $REPOS_FILE"
[ -f "$COLCON_META" ] || die "missing $COLCON_META"
[ -f "$COLCON_DEFAULTS" ] || die "missing $COLCON_DEFAULTS"

UPDATED=()   # repos whose checkout moved, so their build is stale
BLOCKED=()   # repos needing a human: diverged, rejected push, conflicting stash

GRC_GIT_TRANSPORT="${GRC_GIT_TRANSPORT:-ssh}"
ROS_DISTRO="$2"

[ -n "$ROS_DISTRO" ] || die "ros-distro argument is empty"
[[ "$ROS_DISTRO" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid ros-distro: $ROS_DISTRO"
ros_setup_file="/opt/ros/$ROS_DISTRO/setup.bash"
case "${SHELL##*/}" in
    zsh) shell_ext=".zsh"  ;;
    *)   shell_ext=".bash" ;;
esac
[ -r "$ros_setup_file" ] || die "ROS distro '$ROS_DISTRO' is not available at $ros_setup_file"

mkdir -p "$1"
WS="$(cd -- "$1" && pwd -P)"
SRC="$WS/src"
BIN="$WS/bin"
VENV="$WS/.venv"
ENV_FILE="$WS/setup-grc${shell_ext}"
GENERATED_REPOS="$WS/.grc_meta.repos"

# One entry point for every Python install. --python rather than an activated venv:
# it works the same from any mode, sourced or not.
py_install() { run uv pip install --python "$VENV/bin/python" "$@"; }

# The workspace's own packages. Editable, so a source edit needs no reinstall --
# except mj_kdl_wrapper, which compiles an extension and keeps its declared deps.
install_workspace_packages() {
    py_install --no-deps -e "$SRC/rec"
    py_install --no-deps -e "$SRC/rdf-utils"
    py_install --no-deps -e "$SRC/scene-dsl"
    py_install --no-deps -e "$SRC/coord-dsl"
    py_install --no-deps -e "$SRC/motion-spec"
    py_install --no-deps -e "$SRC/motion-spec-dsl"
    py_install --no-deps -e "$SRC/bdd-dsl"
    py_install --no-deps -e "$SRC/robbdd"
    # No --no-deps: pulls in mujoco==3.9.0, its only declared dependency.
    py_install -e "$SRC/mj_kdl_wrapper"
}

if [ "$CLEAN" -eq 1 ]; then
    log "Cleaning build/ install/ log/"
    run rm -rf "$WS/build" "$WS/install" "$WS/log"
fi

log "Checking required system packages"
require_command dpkg-query
REQUIRED_PKGS="ant build-essential ca-certificates cmake git
libegl-dev libeigen3-dev libgl-dev libglfw3-dev liborocos-kdl-dev
libprotobuf-dev libtomlplusplus-dev liburdfdom-dev liburdfdom-headers-dev make ninja-build
pkg-config protobuf-compiler
python3-pip python3-venv python3-colcon-common-extensions python3-rosdep
ros-$ROS_DISTRO-rclcpp ros-$ROS_DISTRO-realtime-tools"
printf "${YELLOW}+ dpkg-query -W -f='\${Status}' %s${NC}\n" $(echo $REQUIRED_PKGS) >&5
missing=""
for pkg in $REQUIRED_PKGS; do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null \
        | grep -q "install ok installed" \
        || missing="$missing $pkg"
done
if [ -n "$missing" ]; then
    die "Missing system packages:$missing

Install them (needs sudo), then rerun this script:
  sudo apt-get update && sudo apt-get install -y$missing"
fi

source_env "$ros_setup_file"
: "${ROS_DISTRO:?ROS setup did not define ROS_DISTRO}"

require_command vcs
require_command rosdep
require_command colcon
require_command python3
require_command git
require_command uv "install it with 'pip install uv', your package manager, or https://astral.sh/uv"

if [ "$MODE" != "build" ]; then
    if [ ! -f "$WS/colcon.meta" ]; then
        log "Preparing workspace at $WS"
        run mkdir -p "$SRC" "$BIN"
        run cp "$COLCON_META" "$WS/colcon.meta"
        run cp "$COLCON_DEFAULTS" "$WS/colcon_defaults.yaml"
    fi

    case "$GRC_GIT_TRANSPORT" in
        ssh)
            run cp "$REPOS_FILE" "$GENERATED_REPOS"
            ;;
        https)
            run sed -E 's#git@github.com:([^/]+)/([^[:space:]]+)#https://github.com/\1/\2#g' \
                "$REPOS_FILE" > "$GENERATED_REPOS"
            ;;
        *)
            die "GRC_GIT_TRANSPORT must be 'ssh' or 'https'"
            ;;
    esac

    log "Importing workspace repositories with $GRC_GIT_TRANSPORT URLs"
    run vcs import "$SRC" < "$GENERATED_REPOS"
fi

# Scope later steps (submodules, rosdep, colcon) to declared repos only, ignoring
# anything else under src/. These are the 2-space-indented keys in the repos file.
mapfile -t IMPORTED_DIRS < <(
    awk '/^  [^[:space:]].*:[[:space:]]*$/ { sub(/:[[:space:]]*$/, ""); sub(/^[[:space:]]+/, ""); print }' \
        "$GENERATED_REPOS"
)
[ "${#IMPORTED_DIRS[@]}" -gt 0 ] || die "no repositories parsed from $GENERATED_REPOS"
IMPORTED_DIRS=("${IMPORTED_DIRS[@]/#/$SRC/}")

if [ "$MODE" != "build" ]; then
    # vcs import checks out the declared ref but never advances a stale local branch,
    # so bring each repo in line with its upstream. grc-lib.sh decides how, the
    # same way script-sync does: push when ahead, stash/fast-forward/pop when behind,
    # and leave a diverged or conflicting repo for its owner instead of aborting the
    # whole setup over it.
    log "Updating workspace repositories"
    for repo in "${IMPORTED_DIRS[@]}"; do
        [ -d "$repo/.git" ] || continue
        printf "  ${YELLOW}%s${NC}\n" "$repo"
        run git -C "$repo" fetch --quiet --tags origin
        set +e; update_repo_branch "$repo"; rc=$?; set -e
        [ -n "$REPO_UPDATE_MSG" ] && printf "    %s\n" "$REPO_UPDATE_MSG"
        [ "$rc" -eq 2 ] && BLOCKED+=("$(basename "$repo"): $REPO_UPDATE_MSG")
        # Moved is not the same as unblocked: a conflicting pop is both.
        [ "$REPO_UPDATE_MOVED" -eq 1 ] && UPDATED+=("$repo")
    done

    # vcs import does not fetch git submodules (e.g. PyKDL's pybind11), so init them.
    log "Initializing git submodules"
    for repo in "${IMPORTED_DIRS[@]}"; do
        [ -f "$repo/.gitmodules" ] && {
            printf "  ${YELLOW}%s${NC}\n" "$repo"
            run git -C "$repo" submodule update --init --recursive
        }
    done
fi

if [ "$MODE" = "ff" ] && [ "${#UPDATED[@]}" -gt 0 ]; then
    # --ff skips the workspace build, which would leave updated sources with stale
    # binaries. Build just the packages that moved.
    log "Rebuilding updated packages"
    ff_build_dirs=()
    for repo in "${UPDATED[@]}"; do
        [ "$(basename "$repo")" = mj_kdl_wrapper ] || ff_build_dirs+=("$repo")
    done
    cd "$WS"
    if [ "${#ff_build_dirs[@]}" -gt 0 ]; then
        run colcon build --base-paths "${ff_build_dirs[@]}" --metas colcon.meta
    fi
    for repo in "${UPDATED[@]}"; do
        # mj_kdl_wrapper compiles twice (colcon and the venv bindings); its script does both.
        if [ "$(basename "$repo")" = mj_kdl_wrapper ] && [ -x "$VENV/bin/python" ]; then
            GRC_WS="$WS" run "$SCRIPT_DIR/script-mj-kdl-wrapper"
        fi
    done
fi

if [ "$MODE" = "full" ]; then
    log "Installing rosdep dependencies"
    if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then
        die "rosdep is not initialized. Initialize it (the only step needing sudo), then rerun this script:
  sudo rosdep init"
    fi
    run rosdep update --rosdistro "$ROS_DISTRO"
    # Skip keys with no apt package: serial's catkin, PyKDL's python3-future,
    # kdl_parser's stale ROS 1 deps, and coord2b (a workspace CMake project with
    # no package.xml) — all build via plain CMake/ament from base-paths regardless.
    run rosdep install --from-paths "${IMPORTED_DIRS[@]}" --ignore-src --rosdistro "$ROS_DISTRO" -y \
        --skip-keys "catkin python3-future cmake_modules rosconsole roscpp rostest coord2b"

    log "Setting up Python virtual environment"
    # uv is required (checked at startup with the other tools). --system-site-packages keeps
    # ROS 2 build tooling (rosidl/empy) importable from the venv.
    log "  uv $(uv --version 2>/dev/null | awk '{print $2}')"

    # A venv built without --system-site-packages cannot see ROS's catkin_pkg, rosidl or empy,
    # and reusing one turns that into "No module named 'catkin_pkg'" from colcon much later,
    # where nothing points back here. Check before trusting an existing venv.
    if [ -e "$VENV/bin/activate" ] \
       && ! grep -qx 'include-system-site-packages = true' "$VENV/pyvenv.cfg" 2>/dev/null; then
        die "the venv at $VENV was created without --system-site-packages, so ROS's Python
       packages (catkin_pkg, rosidl, empy) are invisible to it. Remove it and rerun:
           rm -rf $(quote_path "$VENV")"
    fi

    if [ ! -e "$VENV/bin/activate" ]; then
        # Pin the system interpreter: --system-site-packages inherits the site-packages of
        # whichever Python the venv is built on, and ROS ships catkin_pkg, rosidl and empy into
        # the system one only. Left to choose, uv may pick a managed build it downloaded, and
        # the venv then cannot see any of it -- "No module named 'catkin_pkg'" at colcon time.
        run uv venv --python "$(command -v python3)" --system-site-packages "$VENV"
    fi
    source_env "$VENV/bin/activate"
    # pip itself is still installed under uv: colcon and some ROS tooling shell out to it.
    py_install --upgrade pip setuptools wheel

    log "Installing Python dependencies and workspace packages"
    # empy pinned to 3.3.4: ROS 2's rosidl .em template generators break on empy 4.x.
    # pyparsing is rdflib's core dep; packaging/prettytable/html5rdf are pyshacl's
    # (both rdflib and pyshacl install --no-deps below). scipy backs
    # rdf_utils.models.geometry (undeclared there, pulled in via scene-dsl).
    py_install \
        "empy==3.3.4" \
        "textX[cli]>=4.1.0" \
        textx_ls_core \
        jinja2 \
        platformdirs \
        numpy \
        scipy \
        protobuf \
        pyparsing \
        packaging \
        prettytable \
        html5rdf

    # rdflib is a project fork (src/rdflib, v8.x): install editable with --no-deps so
    # the cloned branch wins over pyshacl/owlrl's rdflib<8 pin. Skip when it's already
    # the editable fork to avoid rebuilding it every run.
    if ! python -c "import rdflib,pathlib,sys; sys.exit(0 if pathlib.Path(rdflib.__file__).resolve().is_relative_to(pathlib.Path('$SRC/rdflib').resolve()) else 1)" 2>/dev/null; then
        py_install --no-deps -e "$SRC/rdflib"
    fi
    py_install --no-deps owlrl pyshacl

    install_workspace_packages
fi

log "Writing workspace environment"
cat > "$ENV_FILE" <<EOF
# Generated by grc_meta/script-setup. Source this file; do not execute it.
if [ -n "\${BASH_VERSION:-}" ] && [ "\${BASH_SOURCE[0]}" = "\$0" ]; then
    printf 'This file must be sourced, not executed:\\n  source %s\\n' "$(quote_path "$ENV_FILE")" >&2
    exit 2
fi

_grc_fail() {
    printf '%s\\n' "\$*" >&2
    return 1
}

_grc_had_nounset=0
[[ -o nounset ]] && _grc_had_nounset=1

_grc_restore_nounset() {
    [ "\$_grc_had_nounset" -eq 1 ] && set -u || set +u
}

_grc_source() {
    [ -r "\$1" ] || { _grc_fail "missing \$1"; return 1; }
    set +u
    # shellcheck disable=SC1090
    . "\$1"
    _grc_status=\$?
    _grc_restore_nounset
    [ "\$_grc_status" -eq 0 ] || { _grc_fail "failed to source \$1"; return "\$_grc_status"; }
}

_grc_prepend_path() {
    [ -d "\$1" ] || return 0
    case ":\${PATH:-}:" in
        *":\$1:"*) ;;
        *) export PATH="\$1\${PATH:+:\$PATH}" ;;
    esac
}

# Save and clear overlay paths so ROS setup doesn't chase missing installs
_grc_saved_colcon="\${COLCON_PREFIX_PATH:-}"
_grc_saved_ament="\${AMENT_PREFIX_PATH:-}"
unset COLCON_PREFIX_PATH AMENT_PREFIX_PATH

# Always source, even if \$ROS_DISTRO already matches: that var is baked into the
# ros:* Docker images at the image level, so it reads as "already sourced" in a
# fresh \`docker exec\` shell that never actually ran setup.bash (PATH/AMENT_PREFIX_PATH
# are unset). Re-sourcing an already-sourced setup.bash is idempotent, so there's no
# downside to dropping the guard.
printf 'sourcing %s\\n' "/opt/ros/$ROS_DISTRO/setup$shell_ext"
_grc_source "/opt/ros/$ROS_DISTRO/setup$shell_ext" || _grc_fail "ROS setup had issues: /opt/ros/$ROS_DISTRO/setup$shell_ext"

if [ "\${VIRTUAL_ENV:-}" != "$(quote_path "$VENV")" ]; then
    printf 'sourcing %s\\n' "$(quote_path "$VENV/bin/activate")"
    _grc_source "$(quote_path "$VENV/bin/activate")" || _grc_fail "Python venv activation had issues: $(quote_path "$VENV/bin/activate")"
fi

# Restore overlay paths for the workspace overlay logic below
[ -n "\$_grc_saved_colcon" ] && export COLCON_PREFIX_PATH="\$_grc_saved_colcon"
[ -n "\$_grc_saved_ament" ] && export AMENT_PREFIX_PATH="\$_grc_saved_ament"
unset _grc_saved_colcon _grc_saved_ament

if [ -r "$(quote_path "$WS/install/local_setup$shell_ext")" ]; then
    case ":\${COLCON_PREFIX_PATH:-}:" in
        *":$(quote_path "$WS/install"):"*) ;;
        *)
            printf 'sourcing %s\\n' "$(quote_path "$WS/install/local_setup$shell_ext")"
            _grc_source "$(quote_path "$WS/install/local_setup$shell_ext")" || _grc_fail "colcon overlay setup had issues: $(quote_path "$WS/install/local_setup$shell_ext")"
            ;;
    esac
else
    printf 'grc setup: warning: install overlay missing; run script-setup first or rebuild with colcon.\\n' >&2
fi

printf 'export METAMODELS_PATH=%s\\n' "$(quote_path "$SRC/metamodels")"
export METAMODELS_PATH=$(quote_path "$SRC/metamodels")
printf 'export INSTALL=%s\\n' "$(quote_path "$WS/install")"
export INSTALL=$(quote_path "$WS/install")
printf 'export GRC_WS=%s\\n' "$(quote_path "$WS")"
export GRC_WS=$(quote_path "$WS")
printf 'export GRC=%s\\n' "$(quote_path "$SCRIPT_DIR/script-grc")"
export GRC=$(quote_path "$SCRIPT_DIR/script-grc")
printf 'add to PATH: %s\\n' "$(quote_path "$BIN")"
_grc_prepend_path "$(quote_path "$BIN")"

[ "\${GRC_SETUP_QUIET:-0}" = 1 ] || printf 'GRC environment ready: %s\\n' "$(quote_path "$WS")"
unset -f _grc_fail _grc_source _grc_restore_nounset _grc_prepend_path
unset _grc_had_nounset _grc_status
EOF

if [ "$MODE" != "ff" ]; then
    # Example/demo/generation CMake trees are not workspace packages: they build
    # generated sources or pull in non-workspace deps (e.g. BehaviorTree.CPP), so
    # colcon must not descend into them.
    log "Marking example and generated artifact trees COLCON_IGNORE"
    for d in \
        "$SRC/motion-spec/generations" \
        "$SRC/motion-spec/code-generator" \
        "$SRC/coord-dsl/examples"; do
        [ -d "$d" ] && run touch "$d/COLCON_IGNORE"
    done

    log "Building colcon workspace"
    cd "$WS"
    run colcon build --base-paths "${IMPORTED_DIRS[@]}" --metas colcon.meta
fi

if [ "$MODE" = "build" ]; then
    # A rebuild also refreshes the editable installs: a workspace package that gained
    # an entry point or a dependency needs reinstalling, and the checkout may have
    # moved since the last full setup.
    [ -x "$VENV/bin/python" ] || die "no virtualenv at $VENV -- run a full setup first"
    log "Refreshing the workspace Python packages"
    install_workspace_packages
fi

if [ "$MODE" != "ff" ]; then
    # STST is the StringTemplate runner every code-generating model needs; without it the
    # first `motion-spec run` dies at codegen with 'stst was not found'. It needs the venv on
    # PATH, so it runs here rather than being left as a step to remember.
    log "Installing the STST code generator"
    run motion-spec setup --prefix "$WS"
fi

log "Setup complete"
printf "${GREEN}Source this environment in new shells:${NC}\n"
printf "  ${CYAN}source %s${NC}\n" "$(quote_path "$ENV_FILE")"
printf "  ${CYAN}motion-spec health --target mujoco${NC}\n"

if [ "${#BLOCKED[@]}" -gt 0 ]; then
    printf "\n${BOLD}${RED}Could not update %d repositories:${NC}\n" "${#BLOCKED[@]}" >&2
    for entry in "${BLOCKED[@]}"; do printf "  %s\n" "$entry" >&2; done
    printf "\nFix the conflicts, then rerun:\n  ${CYAN}%s --ff %s %s${NC}\n" \
        "$(quote_path "$SCRIPT_DIR/script-setup")" "$(quote_path "$WS")" "$ROS_DISTRO" >&2
    exit 1
fi
