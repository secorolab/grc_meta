#!/usr/bin/env bash
# One entry point for the workspace scripts. The generated environment exports it as
# $GRC, so a sourced shell can say `$GRC sync` instead of remembering paths, the
# workspace path and the ROS distro.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=grc-lib.sh
source "$SCRIPT_DIR/grc-lib.sh"

usage() {
    cat <<'USAGE'
Usage: $GRC <command> [args]

  setup [flags] [<workspace> <ros-distro>]
        Create or update the workspace: import, update, rosdep, venv, build.
        Workspace is found from the current directory, distro from the
        environment. Flags (--clean, --ff, --build) pass through.

  source
        Print the generated environment file for this workspace, to source:
            source "$(grc source)"

  sync  Update every repository to what grc_meta.repos declares and rebuild
        what moved.

  build Rebuild the whole workspace with colcon and refresh the editable
        Python installs.

  mj    Rebuild mj_kdl_wrapper alone: the colcon package and the venv bindings.
USAGE
}

die() { printf 'grc: %s\n' "$*" >&2; exit 1; }

# Fill in the workspace and distro when they were not given, so `$GRC setup --clean`
# works from anywhere inside the tree. The workspace is found by walking up from the
# current directory; the distro has no such marker, so it comes from the environment.
append_defaults() {
    local positional=0 a ws
    for a in "$@"; do
        case "$a" in -*) ;; *) positional=$((positional + 1)) ;; esac
    done
    [ "$positional" -ge 2 ] && { printf '%s\n' "$@"; return 0; }
    ws="$(require_workspace "$SCRIPT_DIR")" \
        || die "no workspace here -- run this from inside one, set GRC_WS, or pass <workspace> <ros-distro>"
    [ -n "${ROS_DISTRO:-}" ] \
        || die "ROS_DISTRO is unset -- source the workspace environment, or pass <workspace> <ros-distro>"
    printf '%s\n' "$@" "$ws" "$ROS_DISTRO"
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
    setup)
        mapfile -t args < <(append_defaults "$@")
        exec "$SCRIPT_DIR/script-setup" "${args[@]}"
        ;;
    sync)
        exec "$SCRIPT_DIR/script-sync" "$@"
        ;;
    build)
        mapfile -t args < <(append_defaults --build "$@")
        exec "$SCRIPT_DIR/script-setup" "${args[@]}"
        ;;
    mj)
        exec "$SCRIPT_DIR/script-mj-kdl-wrapper" "$@"
        ;;
    source)
        # A child process cannot export into its parent, so print the path and let the
        # shell source it: source "$(grc source)".
        ws="$(require_workspace "$SCRIPT_DIR")" \
            || die "no workspace here -- run this from inside one, or set GRC_WS"
        case "${SHELL##*/}" in
            zsh) exts=".zsh .bash" ;;
            *)   exts=".bash .zsh" ;;
        esac
        for ext in $exts; do
            if [ -r "$ws/setup-grc$ext" ]; then
                printf '%s\n' "$ws/setup-grc$ext"
                exit 0
            fi
        done
        die "no generated environment in $ws -- run '$(basename "$0") setup' first"
        ;;
    ''|-h|--help|help)
        usage
        ;;
    *)
        printf 'grc: unknown command %s\n\n' "$cmd" >&2
        usage >&2
        exit 2
        ;;
esac
