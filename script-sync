#!/usr/bin/env bash
# Bring an existing workspace up to date with grc_meta.repos and rebuild what moved.
# grc_meta itself is checked first: a stale grc_meta.repos pins everything below it to
# older versions, so syncing against one is worse than not syncing at all.
#
# Per repo, the declared version decides what "outdated" means: a tag is a pin, so the
# checkout must sit on that exact tag; anything else tracks a branch, so the branch is
# fast-forwarded to its upstream. Local work is never discarded: uncommitted changes in
# a repo that has to move are stashed, restored after the update, and kept in the stash
# when they conflict; a diverged branch or one with no upstream is reported, not touched.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=grc-lib.sh
source "$SCRIPT_DIR/grc-lib.sh"

GRC_WS="$(find_workspace "$SCRIPT_DIR")" \
    || { printf 'no workspace here: run this from inside one, or source its environment\n' >&2; exit 1; }
REPOS_FILE="$SCRIPT_DIR/grc_meta.repos"
SRC="$GRC_WS/src"

[ -f "$REPOS_FILE" ] || { printf 'missing %s\n' "$REPOS_FILE" >&2; exit 1; }
command -v colcon >/dev/null 2>&1 \
    || { printf "required command 'colcon' is missing\n" >&2; exit 1; }

info() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
note() { printf '  \033[0;33m%s: %s\033[0m\n' "$1" "$2"; }
moved() { printf '  \033[0;32m%s: %s\033[0m\n' "$1" "$2"; }


# name and declared version of every repository, one pair per line.
declared() {
    awk '/^  [^[:space:]].*:[[:space:]]*$/ { sub(/:[[:space:]]*$/, ""); sub(/^[[:space:]]+/, ""); name=$0 }
         /^    version:/ { print name, $2 }' "$REPOS_FILE"
}

info 'Checking grc_meta'
if git -C "$SCRIPT_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    git -C "$SCRIPT_DIR" fetch --quiet --tags origin
    set +e; update_repo_branch "$SCRIPT_DIR"; rc=$?; set -e
    case "$rc" in
        0)
            moved grc_meta "$REPO_UPDATE_MSG"
            printf '\ngrc_meta.repos may now declare different versions. Rerun the sync:\n  %s\n' "$0"
            exit 0
            ;;
        1) note grc_meta "$REPO_UPDATE_MSG" ;;
        2)
            printf '\ngrc_meta: %s\n' "$REPO_UPDATE_MSG" >&2
            printf 'Fix the conflicts, then rerun the sync:\n  %s\n' "$0" >&2
            exit 1
            ;;
    esac
else
    note grc_meta 'no upstream; skipping its own check'
fi

# A missing repo also needs rosdep and the Python install, which only script-setup
# does, so there is no point updating anything before that is settled.
info 'Checking the workspace layout'
uncloned=()
while read -r name _; do
    [ -d "$SRC/$name/.git" ] || uncloned+=("$name")
done < <(declared)

if [ "${#uncloned[@]}" -gt 0 ]; then
    printf 'declared in grc_meta.repos but not checked out: %s\n' "${uncloned[*]}" >&2
    printf 'They also need rosdep and the Python install, so run script-setup.\n' >&2
    exit 1
fi

info 'Checking workspace repositories'
changed=()
blocked=()
while read -r name version; do
    repo="$SRC/$name"
    git -C "$repo" fetch --quiet --tags origin

    # A declared tag is a pin: the checkout belongs on it. Anything else tracks a
    # branch, which grc-lib.sh handles the same way script-setup does.
    if git -C "$repo" rev-parse -q --verify "refs/tags/$version^{commit}" >/dev/null; then
        [ "$(git -C "$repo" rev-parse HEAD)" = "$(git -C "$repo" rev-parse "refs/tags/$version^{commit}")" ] && {
            note "$name" "at $version"; continue
        }
        # A branch here is deliberate local work -- vcs import leaves a pinned repo
        # detached, so someone checked this out on purpose. Moving onto the tag would
        # detach them from it silently.
        if branch="$(git -C "$repo" symbolic-ref -q --short HEAD)"; then
            note "$name" "is on branch $branch, not the declared pin $version; leaving it alone"
            continue
        fi
        stashed=0
        if repo_dirty "$repo"; then
            git -C "$repo" stash push --quiet -m "grc: before updating to $version"
            stashed=1
        fi
        if ! git -C "$repo" checkout --quiet "$version" 2>/dev/null; then
            [ "$stashed" -eq 1 ] && git -C "$repo" stash pop --quiet
            note "$name" "could not be checked out at $version"
            blocked+=("$name: could not be checked out at $version")
            continue
        fi
        if [ "$stashed" -eq 1 ] && ! git -C "$repo" stash pop --quiet >/dev/null 2>&1; then
            git -C "$repo" reset --hard --quiet
            note "$name" "checked out $version, but your changes conflict with it"
            blocked+=("$name: stashed changes conflict with $version -- git -C $repo stash pop")
        elif [ "$stashed" -eq 1 ]; then
            moved "$name" "checked out $version, local changes restored"
        else
            moved "$name" "checked out $version"
        fi
    else
        set +e; update_repo_branch "$repo"; rc=$?; set -e
        case "$rc" in
            0) moved "$name" "$REPO_UPDATE_MSG" ;;
            1) note "$name" "$REPO_UPDATE_MSG" ;;
            2) note "$name" "$REPO_UPDATE_MSG"; blocked+=("$name: $REPO_UPDATE_MSG") ;;
        esac
        # A conflicting pop is blocked but still moved the checkout, so it is rebuilt:
        # left out, the rerun would see it up to date and never build it.
        [ "$REPO_UPDATE_MOVED" -eq 1 ] || continue
    fi

    [ -f "$repo/.gitmodules" ] && git -C "$repo" submodule update --init --recursive --quiet
    changed+=("$name")
done < <(declared)

# mj_kdl_wrapper is compiled into install/ and the venv rather than used from the
# checkout, so what is installed goes stale on its own -- after an interrupted build, or
# a checkout that moved outside this script. Ask the artifacts what they are, not git.
MJ=mj_kdl_wrapper
MJ_VERSIONS="$SRC/$MJ/cmake/Versions.cmake"
if [ -f "$MJ_VERSIONS" ]; then
    want="$(sed -n 's/^set(MJ_KDL_VERSION "\([^"]*\)").*/\1/p' "$MJ_VERSIONS")"
    have_colcon="$(sed -n 's/^set(PACKAGE_VERSION "\([^"]*\)").*/\1/p' \
        "$GRC_WS/install/$MJ/lib/cmake/$MJ/${MJ}ConfigVersion.cmake" 2>/dev/null || true)"
    have_venv="$("$GRC_WS/.venv/bin/python" -c 'import mj_kdl_wrapper; print(mj_kdl_wrapper.__version__)' 2>/dev/null || true)"
    if [ "$have_colcon" = "$want" ] && [ "$have_venv" = "$want" ]; then
        note "$MJ" "$want installed"
    else
        note "$MJ" "source declares $want, installed ${have_colcon:-none} (colcon) / ${have_venv:-none} (venv)"
        case " ${changed[*]} " in *" $MJ "*) ;; *) changed+=("$MJ") ;; esac
    fi
fi

report_blocked() {
    [ "${#blocked[@]}" -gt 0 ] || return 0
    printf '\n\033[1;31mCould not update %d repositor%s:\033[0m\n' \
        "${#blocked[@]}" "$([ "${#blocked[@]}" -eq 1 ] && echo y || echo ies)" >&2
    for entry in "${blocked[@]}"; do printf '  %s\n' "$entry" >&2; done
    printf '\nFix the conflicts, then rerun the sync:\n  %s\n' "$0" >&2
    exit 1
}

if [ "${#changed[@]}" -eq 0 ]; then
    info 'Everything is up to date; nothing to rebuild'
    report_blocked
    exit 0
fi

# Rebuild before reporting: a repo that moved but never got rebuilt would look up to
# date to the rerun, and its build would then be skipped for good.
info "Rebuilding: ${changed[*]}"
build_dirs=()
for name in "${changed[@]}"; do
    # mj_kdl_wrapper compiles twice (colcon and the venv bindings); its own script does both.
    [ "$name" = mj_kdl_wrapper ] || build_dirs+=("$SRC/$name")
done

if [ "${#build_dirs[@]}" -gt 0 ]; then
    cd "$GRC_WS"
    colcon build --base-paths "${build_dirs[@]}" --metas "$GRC_WS/colcon.meta"
fi

for name in "${changed[@]}"; do
    if [ "$name" = mj_kdl_wrapper ]; then "$SCRIPT_DIR/script-mj-kdl-wrapper"; fi
done

printf '\n\033[0;32mSynced and rebuilt: %s\033[0m\n' "${changed[*]}"
report_blocked
