#!/usr/bin/env bash
# Bring an existing workspace up to date with grc_meta.repos and rebuild what moved.
# grc_meta itself is checked first: a stale grc_meta.repos pins everything below it to
# older versions, so syncing against one is worse than not syncing at all.
#
# Per repo, the declared version decides what "outdated" means: a tag is a pin, so the
# checkout must sit on that exact tag; anything else tracks a branch, so the branch is
# fast-forwarded to its upstream. Local work is never discarded: uncommitted changes in
# a repo that has to move are stashed, restored after the update, and kept in the stash
# when they conflict; a diverged branch or one with no upstream is reported, not touched.
set -euo pipefail

: "${GRC_WS:?is unset -- source the workspace environment (setup-grc.zsh|bash) first}"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPOS_FILE="$SCRIPT_DIR/grc_meta.repos"
SRC="$GRC_WS/src"

[ -f "$REPOS_FILE" ] || { printf 'missing %s\n' "$REPOS_FILE" >&2; exit 1; }
command -v colcon >/dev/null 2>&1 \
    || { printf "required command 'colcon' is missing\n" >&2; exit 1; }

info() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
note() { printf '  \033[0;33m%s: %s\033[0m\n' "$1" "$2"; }
moved() { printf '  \033[0;32m%s: %s\033[0m\n' "$1" "$2"; }

# Commits on the upstream side that the checkout does not have yet.
behind() { git -C "$1" rev-list --count "HEAD..$2"; }

# Tracked changes only: an untracked file survives a checkout or a fast-forward
# untouched, so it is no reason to hold up the sync.
dirty() { [ -n "$(git -C "$1" status --porcelain --untracked-files=no)" ]; }

# name and declared version of every repository, one pair per line.
declared() {
    awk '/^  [^[:space:]].*:[[:space:]]*$/ { sub(/:[[:space:]]*$/, ""); sub(/^[[:space:]]+/, ""); name=$0 }
         /^    version:/ { print name, $2 }' "$REPOS_FILE"
}

info 'Checking grc_meta'
if upstream="$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
    git -C "$SCRIPT_DIR" fetch --quiet --tags origin
    gone="$(behind "$SCRIPT_DIR" "$upstream")"
    local_commits="$(git -C "$SCRIPT_DIR" rev-list --count "$upstream..HEAD")"
    if [ "$gone" -gt 0 ] && [ "$local_commits" -gt 0 ]; then
        printf 'grc_meta has diverged from %s (%s local, %s upstream).\n' \
            "$upstream" "$local_commits" "$gone" >&2
        printf 'Fix the conflicts, then rerun the sync:\n  %s\n' "$0" >&2
        exit 1
    fi
    if [ "$local_commits" -gt 0 ]; then
        git -C "$SCRIPT_DIR" push --quiet 2>/dev/null \
            || { printf 'grc_meta: push to %s was rejected; resolve it, then rerun the sync:\n  %s\n' \
                     "$upstream" "$0" >&2; exit 1; }
        moved grc_meta "pushed $local_commits commit(s) to $upstream"
    fi
    if [ "$gone" -gt 0 ]; then
        stashed=0
        if dirty "$SCRIPT_DIR"; then
            git -C "$SCRIPT_DIR" stash push --quiet -m "script-sync: before updating to $upstream"
            stashed=1
        fi
        if ! git -C "$SCRIPT_DIR" merge --ff-only --quiet "$upstream" 2>/dev/null; then
            [ "$stashed" -eq 1 ] && git -C "$SCRIPT_DIR" stash pop --quiet
            printf 'grc_meta has diverged from %s.\nFix the conflicts, then rerun the sync:\n  %s\n' \
                "$upstream" "$0" >&2
            exit 1
        fi
        if [ "$stashed" -eq 1 ] && ! git -C "$SCRIPT_DIR" stash pop --quiet >/dev/null 2>&1; then
            git -C "$SCRIPT_DIR" reset --hard --quiet
            printf 'grc_meta updated to %s, but your changes conflict with it.\n' "$upstream" >&2
            printf 'Apply them (git -C %s stash pop), fix the conflicts, then rerun the sync:\n  %s\n' \
                "$SCRIPT_DIR" "$0" >&2
            exit 1
        fi
        moved grc_meta "updated to $upstream"
        printf '\ngrc_meta.repos may now declare different versions. Rerun:\n  %s\n' "$0"
        exit 0
    fi
    [ "$local_commits" -eq 0 ] && note grc_meta 'up to date'
else
    note grc_meta 'no upstream; skipping its own check'
fi

# A missing repo also needs rosdep and the Python install, which only script-setup
# does, so there is no point updating anything before that is settled.
info 'Checking the workspace layout'
uncloned=()
while read -r name _; do
    [ -d "$SRC/$name/.git" ] || uncloned+=("$name")
done < <(declared)

if [ "${#uncloned[@]}" -gt 0 ]; then
    printf 'declared in grc_meta.repos but not checked out: %s\n' "${uncloned[*]}" >&2
    printf 'They also need rosdep and the Python install, so run script-setup.\n' >&2
    exit 1
fi

info 'Checking workspace repositories'
changed=()
blocked=()
while read -r name version; do
    repo="$SRC/$name"
    git -C "$repo" fetch --quiet --tags origin

    # Decide first, move second: a repo that is already where it belongs is never
    # stashed, so an up-to-date workspace leaves every working tree untouched.
    if git -C "$repo" rev-parse -q --verify "refs/tags/$version^{commit}" >/dev/null; then
        [ "$(git -C "$repo" rev-parse HEAD)" = "$(git -C "$repo" rev-parse "refs/tags/$version^{commit}")" ] && {
            note "$name" "at $version"; continue
        }
        # A branch here is deliberate local work -- vcs import leaves a pinned repo
        # detached, so someone checked this out on purpose. Moving onto the tag would
        # detach them from it silently.
        if branch="$(git -C "$repo" symbolic-ref -q --short HEAD)"; then
            note "$name" "is on branch $branch, not the declared pin $version; leaving it alone"
            continue
        fi
        action=checkout target="$version"
    elif upstream="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
        gone="$(behind "$repo" "$upstream")"
        local_commits="$(git -C "$repo" rev-list --count "$upstream..HEAD")"
        if [ "$gone" -gt 0 ] && [ "$local_commits" -gt 0 ]; then
            # Both sides moved. Reconciling means a merge commit or a rebase, and
            # neither is this script's call to make.
            note "$name" "has diverged from $upstream ($local_commits local, $gone upstream)"
            blocked+=("$name: diverged from $upstream -- merge or rebase it yourself")
            continue
        elif [ "$local_commits" -gt 0 ]; then
            # Nothing to rebuild: publishing commits does not change the checkout.
            if git -C "$repo" push --quiet 2>/dev/null; then
                moved "$name" "pushed $local_commits commit(s) to $upstream"
            else
                note "$name" "could not push $local_commits commit(s) to $upstream"
                blocked+=("$name: push to $upstream was rejected")
            fi
            continue
        elif [ "$gone" -eq 0 ]; then
            note "$name" "up to date with $upstream"
            continue
        fi
        action=merge target="$upstream"
    else
        note "$name" "on a branch with no upstream; leaving it alone"
        continue
    fi

    # Uncommitted work rides along: stash it, update, put it back. A pop that
    # conflicts keeps the stash entry, so the changes are still recoverable.
    stashed=0
    if dirty "$repo"; then
        git -C "$repo" stash push --quiet -m "script-sync: before updating to $target"
        stashed=1
    fi

    if [ "$action" = merge ]; then
        # --ff-only, never a merge commit: a diverged branch is for its owner to resolve.
        git -C "$repo" merge --ff-only --quiet "$target" 2>/dev/null || action=failed
        done_msg="fast-forwarded to $target"
        fail_msg="has diverged from $target; reconcile it by hand"
    else
        git -C "$repo" checkout --quiet "$target" 2>/dev/null || action=failed
        done_msg="checked out $target"
        fail_msg="could not be checked out at $target; resolve it by hand"
    fi

    if [ "$action" = failed ]; then
        note "$name" "$fail_msg"
        blocked+=("$name: $fail_msg")
        [ "$stashed" -eq 1 ] && git -C "$repo" stash pop --quiet
        continue
    fi

    if [ "$stashed" -eq 1 ] && ! git -C "$repo" stash pop --quiet >/dev/null 2>&1; then
        # A conflicting pop keeps the stash entry but leaves conflict markers in the
        # tree, which the rebuild below would then compile. Reset to the clean updated
        # checkout and leave the work in the stash for its owner to apply.
        git -C "$repo" reset --hard --quiet
        note "$name" "$done_msg, but your changes conflict with it"
        blocked+=("$name: stashed changes conflict with $target -- git -C $repo stash pop")
    else
        [ "$stashed" -eq 1 ] && done_msg="$done_msg, local changes restored"
        moved "$name" "$done_msg"
    fi

    [ -f "$repo/.gitmodules" ] && git -C "$repo" submodule update --init --recursive --quiet
    changed+=("$name")
done < <(declared)

# mj_kdl_wrapper is compiled into install/ and the venv rather than used from the
# checkout, so what is installed goes stale on its own -- after an interrupted build, or
# a checkout that moved outside this script. Ask the artifacts what they are, not git.
MJ=mj_kdl_wrapper
MJ_VERSIONS="$SRC/$MJ/cmake/Versions.cmake"
if [ -f "$MJ_VERSIONS" ]; then
    want="$(sed -n 's/^set(MJ_KDL_VERSION "\([^"]*\)").*/\1/p' "$MJ_VERSIONS")"
    have_colcon="$(sed -n 's/^set(PACKAGE_VERSION "\([^"]*\)").*/\1/p' \
        "$GRC_WS/install/$MJ/lib/cmake/$MJ/${MJ}ConfigVersion.cmake" 2>/dev/null || true)"
    have_venv="$("$GRC_WS/.venv/bin/python" -c 'import mj_kdl_wrapper; print(mj_kdl_wrapper.__version__)' 2>/dev/null || true)"
    if [ "$have_colcon" = "$want" ] && [ "$have_venv" = "$want" ]; then
        note "$MJ" "$want installed"
    else
        note "$MJ" "source declares $want, installed ${have_colcon:-none} (colcon) / ${have_venv:-none} (venv)"
        case " ${changed[*]} " in *" $MJ "*) ;; *) changed+=("$MJ") ;; esac
    fi
fi

report_blocked() {
    [ "${#blocked[@]}" -gt 0 ] || return 0
    printf '\n\033[1;31mCould not update %d repositor%s:\033[0m\n' \
        "${#blocked[@]}" "$([ "${#blocked[@]}" -eq 1 ] && echo y || echo ies)" >&2
    for entry in "${blocked[@]}"; do printf '  %s\n' "$entry" >&2; done
    printf '\nFix the conflicts, then rerun the sync:\n  %s\n' "$0" >&2
    exit 1
}

if [ "${#changed[@]}" -eq 0 ]; then
    info 'Everything is up to date; nothing to rebuild'
    report_blocked
    exit 0
fi

# Rebuild before reporting: a repo that moved but never got rebuilt would look up to
# date to the rerun, and its build would then be skipped for good.
info "Rebuilding: ${changed[*]}"
build_dirs=()
for name in "${changed[@]}"; do
    # mj_kdl_wrapper compiles twice (colcon and the venv bindings); its own script does both.
    [ "$name" = mj_kdl_wrapper ] || build_dirs+=("$SRC/$name")
done

if [ "${#build_dirs[@]}" -gt 0 ]; then
    cd "$GRC_WS"
    colcon build --base-paths "${build_dirs[@]}" --metas "$GRC_WS/colcon.meta"
fi

for name in "${changed[@]}"; do
    if [ "$name" = mj_kdl_wrapper ]; then "$SCRIPT_DIR/script-mj-kdl-wrapper"; fi
done

printf '\n\033[0;32mSynced and rebuilt: %s\033[0m\n' "${changed[*]}"
report_blocked
